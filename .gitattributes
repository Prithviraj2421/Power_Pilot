# Normalize line endings in the repository to LF regardless of contributor OS.
# Without this, a Windows checkout (core.autocrlf=true) commits CRLF and every
# Linux/CI clone sees the whole file as changed.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to execute correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must keep LF even on Windows checkouts.
*.sh   text eol=lf

# Text formats — normalize.
*.py   text
*.ts   text
*.tsx  text
*.js   text
*.jsx  text
*.json text
*.css  text
*.html text
*.md   text
*.yml  text
*.yaml text
*.csv  text
*.svg  text
*.dax  text
*.bim  text
*.m    text

# Binary formats — never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.xlsx binary
*.xlsm binary
*.docx binary
*.pptx binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
