# PowerPilot backend configuration
#
# Copy to .env and edit. Every variable below is optional -- the defaults shown
# are what the application uses when the variable is absent. All settings are
# read by app/core/config.py; nothing else in the codebase touches os.environ.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# --- Application ------------------------------------------------------------
POWERPILOT_APP_NAME=PowerPilot API
POWERPILOT_APP_VERSION=1.0.0

# Enables FastAPI debug mode. Leave false outside local development.
POWERPILOT_DEBUG=false

# --- CORS -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Do NOT use "*" here: browsers reject a wildcard origin when credentials are
# allowed, so a wildcard silently breaks every credentialed request.
POWERPILOT_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
POWERPILOT_CORS_ALLOW_CREDENTIALS=true

# --- Uploads ----------------------------------------------------------------
# Maximum accepted CSV upload size, in megabytes.
POWERPILOT_MAX_UPLOAD_MB=50

# --- Dataset registry -------------------------------------------------------
# Directory holding uploaded CSV source files and the SQLite metadata database.
# Relative paths resolve against the backend/ directory.
POWERPILOT_DATA_DIR=data

# Number of computed analyses held in memory. A cache miss re-runs the pipeline
# from the stored CSV, so this bounds memory without ever losing a dataset.
POWERPILOT_RESULT_CACHE_SIZE=32

# Seconds a cached analysis stays valid. Set to 0 to disable expiry.
POWERPILOT_RESULT_CACHE_TTL_SECONDS=3600

# Datasets retained on disk. The least recently accessed are pruned beyond this.
# Set to 0 to disable pruning and keep every dataset.
POWERPILOT_MAX_STORED_DATASETS=200

# --- Email delivery ---------------------------------------------------------
# Plain SMTP, so the same settings work with Gmail, Amazon SES's SMTP endpoint,
# SendGrid's SMTP relay or a self-hosted server.
#
# Email is DISABLED until both SMTP_HOST and SMTP_FROM_ADDRESS are set. Until
# then the endpoint returns 503 and the UI says so -- it never silently discards
# a report.
#
# Never commit real credentials. Most providers require an app-specific password
# or API-key-as-password rather than your account password.
POWERPILOT_SMTP_HOST=
POWERPILOT_SMTP_FROM_ADDRESS=
POWERPILOT_SMTP_FROM_NAME=PowerPilot

# Leave the username blank for a relay that does not require authentication.
POWERPILOT_SMTP_USERNAME=
POWERPILOT_SMTP_PASSWORD=

# Transport security. These are mutually exclusive and startup fails if both are
# true. Use TLS (STARTTLS) on port 587, or SSL (implicit TLS) on port 465.
POWERPILOT_SMTP_PORT=587
POWERPILOT_SMTP_USE_TLS=true
POWERPILOT_SMTP_USE_SSL=false

POWERPILOT_SMTP_TIMEOUT_SECONDS=30
POWERPILOT_MAX_EMAIL_RECIPIENTS=20

# Provider quick reference:
#   Gmail       host=smtp.gmail.com        port=587  TLS  (app password required)
#   Amazon SES  host=email-smtp.<region>.amazonaws.com  port=587  TLS
#   SendGrid    host=smtp.sendgrid.net     port=587  TLS  (username "apikey")
#   Mailgun     host=smtp.mailgun.org      port=587  TLS
